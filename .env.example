# Boutique Shopify (sans https, sans chemin final)
SHOPIFY_SHOP=ta-boutique.myshopify.com

# --- Jeton Admin API (au choix) ---
# A) Recommandé (app Partners, installation gérée, flux hérité = false) : laisser vide.
#    Le serveur obtient le jeton via client_credentials (POST access_token) et le rafraîchit ~toutes les 24 h.
# B) Optionnel : token statique (ex. shpat depuis « Développer des applications ») — prioritaire si défini.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# App Partners — Identifiants (requis pour A, et pour OAuth navigateur legacy)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Secret webhook Shopify (HMAC) — en pratique le même Secret Partners que ci-dessus
SHOPIFY_WEBHOOK_SECRET=

# --- OAuth navigateur (uniquement si « flux d’installation hérité : true ») ---
# OAUTH_PUBLIC_URL=https://emeria-backend.onrender.com
# OAUTH_REDIRECT_URI=
# OAUTH_INSTALL_SECRET=
# OAUTH_SCOPES=read_orders,write_orders,write_draft_orders,read_customers
# OAUTH_GRANT_OPTIONS=offline
# (OAUTH_GRANT_OPTIONS=none pour désactiver grant_options[] sur /oauth/start)

# Optionnel — webhooks Recharge
RECHARGE_WEBHOOK_SECRET=

# Optionnel — POST /hooks/reconstruct
INTERNAL_RECONSTRUCT_SECRET=

PORT=8787
PUBLIC_BASE_PATH=
ORDER_WEBHOOK_TOPICS=orders/paid
AUTO_RECONSTRUCT_ON_RENEWAL=0
