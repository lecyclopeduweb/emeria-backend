# Boutique Shopify (sans https, sans chemin final)
SHOPIFY_SHOP=ta-boutique.myshopify.com

# Custom app Admin API : token avec droits read_orders, write_orders, write_draft_orders, read_customers
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Secret webhook Shopify (déclaré dans l’app Custom > Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# Optionnel — si tu sécurises les webhooks Recharge (voir doc Recharge pour le header exact)
RECHARGE_WEBHOOK_SECRET=

# Optionnel — même secret pour POST /hooks/reconstruct manuel (sinon désactivé si vide)
INTERNAL_RECONSTRUCT_SECRET=

PORT=8787

# Si l’app est dans un sous-dossier public (sans slash final), ex. /Rushs/passionkanine/emeria-backend
# Les URLs deviennent : https://domaine.fr…/emeria-backend/health
PUBLIC_BASE_PATH=

# Webhooks Shopify à traiter (séparateur virgule). Ex. orders/paid ou orders/paid,orders/create
ORDER_WEBHOOK_TOPICS=orders/paid

# 1 = crée un draft order à chaque webhook Recharge (à utiliser seulement si le payload contient le bon subscription + source order)
AUTO_RECONSTRUCT_ON_RENEWAL=0
